<form
  id='contact-form'
  action=''
  class='bg-gray-200 flex flex-col items-center justify-center p-6 gap-y-4 shadow-md w-full md:w-1/2 rounded-lg'
>
  <h3 class='title text-2xl font-semibold'>Contáctanos</h3>
  <p class='text-gray-600'>Te responderemos a la brevedad</p>
  <input
    type='text'
    name='name'
    id='name'
    placeholder='Nombre*'
    class='font-light text-sm md:text-base border-2 rounded-md p-2 w-full'
    required
  />
  <input
    type='email'
    name='email'
    id='email'
    placeholder='Correo electrónico*'
    class='font-light text-sm md:text-base border-2 rounded-md p-2 w-full'
    required
  />
  <input
    type='tel'
    name='phone'
    id='phone'
    pattern='[0-9]{10}'
    placeholder='Teléfono (55xxxxxxxx)'
    class='font-light text-sm md:text-base border-2 rounded-md p-2 w-full'
  />
  <input
    type='text'
    name='subject'
    id='subject'
    placeholder='Asunto'
    class='font-light text-sm md:text-base border-2 rounded-md p-2 w-full'
  />
  <textarea
    name='message'
    id='message'
    rows='8'
    placeholder='Mensaje*'
    class='resize-none font-light text-sm md:text-base border-2 rounded-md p-2 w-full'
    required></textarea>
  <input
    type='submit'
    value='Enviar'
    class='bg-gradient-to-r from-[#0400ff] to-[#4ce3f7] w-1/2 md:w-1/4 py-1 px-2 md:py-1 rounded-full text-whiteP md:text-lg cursor-pointer'
  />
</form>
<script>
  import emailjs from 'emailjs-com';

  const form = document.getElementById('contact-form') as HTMLFormElement;

  const sendEmail = () => {
    let params = {
      name: (document.getElementById('name') as HTMLInputElement)?.value,
      email: (document.getElementById('email') as HTMLInputElement)?.value,
      phone: (document.getElementById('phone') as HTMLInputElement)?.value,
      subject: (document.getElementById('subject') as HTMLInputElement)?.value,
      message: (document.getElementById('message') as HTMLInputElement)?.value,
    };

    const serviceID = 'service_ywb6pym';
    const templateID = 'template_yzynnhk';

    emailjs.init('w8KWkZcXTpXrayGWS');

    emailjs
      .send(serviceID, templateID, params)
      .then((res) => {
        console.log(res);

        form?.reset();

        alert('Mensaje enviado exitosamente');
      })
      .catch((err) => {
        console.log(err);
      });
  };

  document.addEventListener('submit', (e) => {
    e.preventDefault();

    sendEmail();
  });
</script>
