---
import 'swiper/css';
import 'swiper/css/autoplay';
import 'swiper/css/pagination';

const { heroData } = Astro.props;
---

<div class='swiper w-screen h-auto md:h-screen'>
  <div class='swiper-wrapper'>
    {
      heroData.map((data: any) => (
        <div class='swiper-slide mb-10 md:mb-auto h-auto mt-16 md:mt-auto md:h-full px-6 md:px-12 lg:px-16 flex items-center justify-between gap-8 flex-col md:flex-row'>
          <div class='flex flex-col gap-6'>
            <h2 class='text-blue-700 text-4xl lg:text-7xl font-bold'>
              {data.textTitle}
            </h2>
            <h3 class='text-gray-700 text-base lg:text-xl'>
              {data.textDescription}
            </h3>
            <a href={data.href} class='button-home text-sm md:text-base w-fit'>
              {data.textButton}
            </a>
          </div>
          <div class='lg:h-full flex items-center md:min-w-[30%]'>
            <div class='bg-blue-300 rounded-full '>
              <img
                class='w-auto max-h-[300px] lg:max-h-[850px] object-contain'
                src={data.img}
                alt={data.alt}
              />
            </div>
          </div>
        </div>
      ))
    }
  </div>
  <!-- If we need pagination -->
  <div class='swiper-pagination'></div>
</div>
<style>
  .swiper-slide {
    display: flex;
  }
</style>
<script src='../../lib/swiper-home.js'></script>
