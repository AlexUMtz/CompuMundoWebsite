---
import SwiperProducts from './swiper-products.astro';

import productsImgFirst from '../../data/products-img-1.json';
import productsImgSecond from '../../data/products-img-2.json';
---

<section id='products' class='container-section bg-gray-100'>
  <div class='title-container'>
    <p class='text-p'>Conoce más acerca de nuestros servicios</p>
    <h2 class='title'>Productos</h2>
  </div>
  <div class='grid grid-cols-3 md:grid-cols-5 grid-rows-6 gap-4'>
    <!-- Celda 1 -->
    <div
      class='bg-white col-span-2 row-span-2 md:col-span-3 md:row-span-3 shadow-lg overflow-hidden rounded-md'
    >
      <SwiperProducts products={productsImgFirst} />
    </div>

    <!-- Celda 2 -->
    <div
      class='bg-gradient-to-r from-[#0400ff] to-[#4ce3f7] col-start-3 row-span-2 md:col-span-2 md:row-span-3 md:col-start-4 md:row-start-1 shadow-md rounded-md p-7 flex flex-col items-center gap-7'
    >
      <p class='text-xs md:text-base text-white'>
        Explora nuestra selección completa de laptops, impresoras, periféricos y
        mucho más. ¡Todo lo que necesitas en un solo lugar!
      </p>
      <a
        href=''
        class='bg-whiteP hover:bg-opacity-85 text-blue-700 font-semibold text-center text-xs md:text-base py-1 px-3 rounded-full cursor-pointer transition duration-200'
      >
        Ver productos
      </a>
    </div>

    <!-- Celda 3 -->
    <div
      class='bg-white col-span-3 row-span-1 md:col-span-1 md:row-span-3 md:row-start-4 p-7 shadow-md rounded-md flex items-center'
    >
      <p class='text-gray-700 text-center text-[.9rem]'>
        Encuentra todo lo que necesitas en computación: laptops, desktops,
        impresoras y más. <b class='text-blue-700'
          >Visitanos para conocer el catálogo completo</b
        >
      </p>
    </div>

    <!-- Celda 4 -->
    <div
      class='bg-white col-span-2 row-span-2 md:col-span-3 md:row-span-3 md:col-start-2 md:row-start-4 shadow-lg overflow-hidden rounded-md'
    >
      <SwiperProducts products={productsImgSecond} />
    </div>

    <!-- Celda 5 -->
    <div
      class='bg-white col-start-3 col-span-1 row-span-2 md:col-span-1 md:row-span-3 md:col-start-5 md:row-start-4 p-9 md:p-4 rounded-md shadow-md flex justify-center flex-col items-center gap-5'
    >
      <p class='text-gray-700 text-center'>¿No encuentras lo que buscas?</p>
      <a class='btn-general text-xs md:text-sm'>Contáctanos</a>
    </div>
  </div>
</section>
