---
const contactData = [
  {
    typeData: 'WhatsApp:',
    textData: '55 7047 3662',
    hrefData: 'https://wa.me/525570473662',
    iconClass: 'fa-brands fa-whatsapp',
  },
  {
    typeData: 'Teléfono:',

    textData: '55 5778 9145',
    hrefData: 'tel:+525557789145',
    iconClass: 'fa-solid fa-phone',
  },
  {
    typeData: 'Correo:',
    textData: 'compumundost@outlook.com',
    hrefData: 'mailto:compumundost@outlook.com',
    iconClass: 'fa-solid fa-envelope',
  },
];
---

<div class='flex flex-col gap-y-3 w-full md:w-1/2'>
  {
    contactData.map((data) => (
      <div class=' bg-white flex flex-wrap items-center shadow-md p-4 gap-x-2 rounded-lg md:pl-28'>
        <a href={data.hrefData}>
          <i
            class={`${data.iconClass} text-white bg-gradient-to-r from-[#0400ff] to-[#4ce3f7] text-xl  flex items-center justify-center rounded-full w-9 h-9 md:w-12 md:h-12`}
          />
          {/* bg-gradient-to-r from-[#0400ff] to-[#4ce3f7] */}
        </a>
        <b class='text-[#343e52]'>{data.typeData}</b>
        <a href={data.hrefData} class='text-[#343e52] text-sm md:text-base'>
          {data.textData}
        </a>
      </div>
    ))
  }

  <div
    class='bg-white h-full flex flex-col items-center shadow-md p-4 gap-y-2 rounded-lg'
  >
    <i
      class='fa-solid fa-location-dot text-white text-xl bg-gradient-to-r from-[#0400ff] to-[#4ce3f7] flex items-center justify-center rounded-full w-9 h-9 md:w-12 md:h-12'
    ></i>

    <p class='text-[#343e52] text-sm'>
      Cuauhtémoc 126, Cd Azteca 1ra Secc, 55120 Ecatepec de Morelos, Méx.
    </p>
    <iframe
      src='https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d234.99374158755492!2d-99.0335098172121!3d19.545912121491845!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85d1f012950e0a9b%3A0x6619a34b72e1ce5e!2sCuauht%C3%A9moc%20126%2C%20Cd%20Azteca%201ra%20Secc%2C%2055120%20Ecatepec%20de%20Morelos%2C%20M%C3%A9x.!5e0!3m2!1ses-419!2smx!4v1735954959686!5m2!1ses-419!2smx'
      width='600'
      height='450'
      style='border:0;'
      allowfullscreen=''
      loading='lazy'
      referrerpolicy='no-referrer-when-downgrade'
      class='w-full rounded-lg md:h-full'></iframe>
  </div>
  <!-- #0400ff, #4ce3f7 -->
</div>
