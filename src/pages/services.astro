---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import HeroService from '@components/Services/Hero-services.astro';
import DescriptionService from '@components/Services/Description-services.astro';
import ContainerServices from '@components/Services/Container-services.astro';
---

<Layout>
  <Header />
  <HeroService />
  <DescriptionService />
  <ContainerServices />
  <Footer />
</Layout>

<script>
  window.addEventListener('load', () => {
    const hash = window.location.hash;
    if (hash) {
      const target = document.querySelector(hash);
      if (target) {
        // Espera unos pocos frames para asegurar layout y render
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            target.scrollIntoView({
              behavior: 'smooth',
              block: 'center',
            });
          });
        });
      }
    }
  });
</script>

